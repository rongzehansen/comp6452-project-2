// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Run the following command in backend ternimal when the model has changed.
// > npx prisma migrate dev --name init 
model Group {
  id             Int      @id @default(autoincrement())
  index          Int @unique
  name           String
  owner          String
  voteOpen       Boolean @default(false)
  depositOpen    Boolean @default(true)
  applicationOpen Boolean @default(false)
  interestRate   Int @default(0)
  monthlyPayment Int @default(0)
  period         Int @default(1)
  timeCreated    DateTime @default(now())
  timeUpdated    DateTime @updatedAt
}

model Vote {
  id        Int      @id @default(autoincrement())
  groupId   Int   @unique
  voteResult String
  timeCreated    DateTime @default(now())
  timeUpdated    DateTime @updatedAt
}
